// SLPL Store data model.
// All money fields are integers in paise (₹1 = 100) — never floats.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Customers ────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  phone             String?
  passwordHash      String
  emailVerified     DateTime?
  image             String?
  lastLoginAt       DateTime?
  notificationPrefs Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  notifications Notification[]
  grievances    Grievance[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum AddressLabel {
  HOME
  OFFICE
  OTHER
}

model Address {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     AddressLabel @default(HOME)
  name      String? // custom nickname, e.g. "Granny's house"
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  lat       Float?
  lng       Float?
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([userId])
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  sortOrder   Int       @default(0)
  products    Product[]
}

enum ProductKind {
  BOOK
  NOVEL
  POEMS
  BUNDLE
}

/// How a line is counted on an invoice.
enum ProductUnit {
  PCS
  SET
  BOOK
  YEAR
  SESSION
}

model Product {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  kind            ProductKind @default(BOOK)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  series          String?
  gradeLabel      String?
  description     String
  /// Master stock register code, e.g. BS1TEL01. See lib/sku.ts for the grammar.
  sku             String?     @unique
  /// 4901 for printed books, nil rated. SAC 9992 at 18% for services.
  hsnCode         String?
  /// Basis points, so 0% and 18% are exact: 0 and 1800.
  gstRate         Int         @default(0)
  unit            ProductUnit @default(PCS)
  /// What we paid. Restricted to OWNER and MANAGER on every screen.
  purchasePrice   Int?
  /// Selling below this needs approval.
  minPrice        Int?
  discountAllowed Boolean     @default(true)
  /// Withdrawn titles stay on old invoices but cannot be added to new ones.
  isActive        Boolean     @default(true)
  mrp             Int
  price           Int
  salePrice       Int?
  saleStart       DateTime?
  saleEnd         DateTime?
  stock           Int         @default(0)
  weightGrams     Int         @default(350)
  coverImage      String?
  gallery         String[]    @default([])
  samplePdf       String?
  isNewRelease    Boolean     @default(false)
  isFeatured      Boolean     @default(false)
  isVisible       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  bundleItems BundleItem[] @relation("bundle")
  memberOf    BundleItem[] @relation("member")
  cartItems   CartItem[]
  orderItems  OrderItem[]
  schoolKits  SchoolKit[]

  @@index([categoryId, isVisible])
  @@index([isNewRelease, isVisible])
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Product @relation("bundle", fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation("member", fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([bundleId, productId])
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

enum OrderStatus {
  AWAITING_PAYMENT
  COD_PENDING_OTP
  PAID
  CONFIRMED // COD confirmed via OTP
  PAYMENT_FAILED
  EXPIRED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(AWAITING_PAYMENT)
  paymentMethod   PaymentMethod
  subtotal        Int
  discount        Int           @default(0)
  couponCode      String?
  shippingFee     Int           @default(0)
  total           Int
  // Snapshot of the delivery address at order time (source Address may change later)
  shippingAddress Json
  customerName    String
  customerEmail   String
  customerPhone   String
  notes           String?
  reservedUntil   DateTime?
  // COLLECT_AT_SCHOOL orders are handed over at the school, never couriered
  fulfilment      Fulfilment    @default(SHIP)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items        OrderItem[]
  payment      Payment?
  shipment     Shipment?
  events       OrderEvent[]
  grievances   Grievance[]
  kitPurchases KitPurchase[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  unitPrice Int
  quantity  Int
  image     String?
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String // "razorpay" | "cod"
  status            PaymentStatus @default(CREATED)
  amount            Int
  refundedAmount    Int           @default(0)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  method            String? // upi | card | netbanking | wallet
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  events PaymentEvent[]
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // Razorpay event id (or synthetic id for local transitions) — dedupes webhook retries
  eventId   String   @unique
  type      String
  payload   Json
  createdAt DateTime @default(now())
}

// ─── Shipping ─────────────────────────────────────────────────────────────────

enum ShipmentStatus {
  PENDING
  CREATED
  PICKUP_SCHEDULED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
}

model Shipment {
  id                   String         @id @default(cuid())
  orderId              String         @unique
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider             String // "shiprocket" | "manual"
  status               ShipmentStatus @default(PENDING)
  courierName          String?
  awb                  String?
  trackingUrl          String?
  labelUrl             String?
  shiprocketOrderId    String?
  shiprocketShipmentId String?
  etaDays              Int?
  trackingPhotoUrl     String? // courier receipt photo, served admin-only
  packedAt             DateTime?
  lastTrackedAt        DateTime? // last courier API poll, used to ration lookups
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  events ShipmentEvent[]

  @@index([status])
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  location    String?
  description String?
  occurredAt  DateTime @default(now())
  raw         Json?

  @@index([shipmentId])
}

model DeliveryEstimateCache {
  // key = `${pincode}:${weightBandGrams}`
  key       String   @id
  etaDays   Int
  charge    Int
  courier   String?
  expiresAt DateTime
}

// ─── Promotions ───────────────────────────────────────────────────────────────

enum DiscountType {
  PERCENT
  FLAT
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType
  value       Int // percent (1-100) or paise
  minOrder    Int          @default(0)
  maxDiscount Int?
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usedCount   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
}

model SaleEvent {
  id           String       @id @default(cuid())
  name         String
  bannerText   String
  discountType DiscountType
  value        Int
  categoryIds  String[]     @default([]) // empty = sitewide
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
}

// ─── Misc ─────────────────────────────────────────────────────────────────────

model OtpToken {
  id         String    @id @default(cuid())
  identifier String // email address
  code       String
  purpose    String // BULK_ORDER | COD_CONFIRM | EMAIL_VERIFY
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
}

model Setting {
  key   String @id
  value Json
}

model ServicePage {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  tagline     String?
  description String
  bannerImage String?
  externalUrl String?
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String // SENT | FAILED
  error     String?
  createdAt DateTime @default(now())
}

// ─── Grievance redressal ──────────────────────────────────────────────────────
// Statutory complaint channel: the Consumer Protection (E-Commerce) Rules
// require a named officer, a 48 h acknowledgement and a 30 day resolution, so
// both clocks are stamped on the row at creation and reported on in admin.

enum GrievanceStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
  ESCALATED
}

enum GrievanceCategory {
  PAYMENT_DEBITED_NO_ORDER
  REFUND_NOT_RECEIVED
  DOUBLE_CHARGED
  ORDER_NOT_DELIVERED
  DAMAGED_OR_WRONG_ITEM
  CANCELLATION_ISSUE
  DATA_PRIVACY
  OTHER
}

enum GrievancePriority {
  NORMAL
  HIGH
  URGENT
}

model Grievance {
  id           String  @id @default(cuid())
  ticketNumber String  @unique // SLPL-G-YYMM-XXXXX
  accessToken  String  @unique // unguessable, powers the emailed tracking link
  userId       String? // null when filed by a guest
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId      String?
  order        Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // What the customer typed as their order number, kept even when unmatched
  orderRef     String?

  category    GrievanceCategory
  subject     String
  description String

  // Contact snapshot: guests have no account row to fall back on
  contactName  String
  contactEmail String
  contactPhone String?

  // Payment complaints: customer-supplied reference and the amount in dispute
  paymentRef    String?
  amountClaimed Int? // paise

  status   GrievanceStatus   @default(OPEN)
  priority GrievancePriority @default(NORMAL)

  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolution     String?
  ackDueAt       DateTime // createdAt + 48 h
  dueAt          DateTime // createdAt + 30 days

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events GrievanceEvent[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([contactEmail])
}

model GrievanceEvent {
  id                String    @id @default(cuid())
  grievanceId       String
  grievance         Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  status            String
  note              String?
  byAdmin           Boolean   @default(false)
  visibleToCustomer Boolean   @default(true)
  createdAt         DateTime  @default(now())

  @@index([grievanceId])
}

// ─── School kits ──────────────────────────────────────────────────────────────
// A parent pays online for one named student's kit, gets a receipt carrying a
// QR code, and the school hands the kit over against that receipt.

enum Fulfilment {
  SHIP
  COLLECT_AT_SCHOOL
}

enum KitPurchaseStatus {
  PENDING // order created, payment not through yet
  PAID
  READY // school has the kit set aside
  COLLECTED
  CANCELLED
}

model School {
  id           String  @id @default(cuid())
  code         String  @unique // short code used in URLs and on receipts
  name         String
  city         String
  state        String  @default("Telangana")
  // Matches Institution.udiseCode in the ERP so the two can be joined later
  udiseCode    String? @unique
  contactName  String?
  contactPhone String?
  contactEmail String?
  // Shared secret school staff type to reach the verification screen
  verifyPin    String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kits     SchoolKit[]
  students Student[]

  @@index([isActive])
}

model SchoolKit {
  id             String  @id @default(cuid())
  schoolId       String
  school         School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // The BUNDLE product carrying the price and the contents
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  academicYear   String // "2026-27"
  classLabel     String // "Grade 3"
  collectionNote String? // "Collect from the school office, 9am to 3pm"
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases KitPurchase[]

  @@unique([schoolId, academicYear, classLabel])
  @@index([schoolId, isActive])
}

model Student {
  id            String  @id @default(cuid())
  schoolId      String
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fullName      String
  classLabel    String
  section       String  @default("A")
  rollNumber    String
  guardianPhone String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases KitPurchase[]

  @@unique([schoolId, classLabel, section, rollNumber])
  @@index([schoolId, classLabel])
}

model KitPurchase {
  id            String            @id @default(cuid())
  receiptNumber String            @unique // SLPL-K-YYMM-XXXXX
  accessToken   String            @unique // the QR payload, unguessable
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  schoolKitId   String
  schoolKit     SchoolKit         @relation(fields: [schoolKitId], references: [id])
  studentId     String?
  student       Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  // Snapshots, so a roster edit or a transferred student cannot rewrite a receipt
  studentName   String
  classLabel    String
  section       String
  rollNumber    String?
  schoolName    String
  kitTitle      String
  amountPaid    Int // paise
  status        KitPurchaseStatus @default(PENDING)
  collectedAt   DateTime?
  collectedBy   String? // name the school staff member typed
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  events KitCollectionEvent[]

  @@index([schoolKitId, status])
  @@index([studentId])
  @@index([orderId])
}

model KitCollectionEvent {
  id            String      @id @default(cuid())
  purchaseId    String
  purchase      KitPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  status        String
  note          String?
  bySchoolStaff Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([purchaseId])
}

// ─── Director expense log ─────────────────────────────────────────────────────
// Every rupee that leaves the current account, logged as it is spent, so an
// audit can be answered with a printed statement instead of a shoebox.

enum ExpenseCategory {
  FUEL
  TRAVEL
  STATIONERY
  PRINTING
  COURIER
  OFFICE
  UTILITIES
  RENT
  REPAIRS
  PROFESSIONAL_FEES
  SALARIES
  MARKETING
  MEALS
  BANK_CHARGES
  MISC
}

enum PaidFrom {
  CURRENT_ACCOUNT
  CASH
  CARD
  UPI
  CHEQUE
}

model Expense {
  id          String          @id @default(cuid())
  voucherNo   String          @unique // SLPL-E-YYMM-XXXXX
  /// The date on the bill, not the date it was typed in
  spentAt     DateTime
  amount      Int // paise
  category    ExpenseCategory
  paidFrom    PaidFrom        @default(CURRENT_ACCOUNT)
  payee       String?
  note        String?
  /// Cheque number, UPI reference or the bank narration, for reconciliation
  reference   String?
  /// Photo of the bill, stored admin-only because bills carry addresses
  billImage   String?
  /// Filled only when the bill shows GST we could reclaim
  gstAmount   Int?
  vendorGstin String?
  enteredBy   String          @default("Director")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([spentAt])
  @@index([category, spentAt])
}

// ─── Staff accounts ───────────────────────────────────────────────────────────
// Ported verbatim from the ERP fork so the two systems stay schema compatible
// and the rest of its finance layer can follow without a rewrite.

enum AdminRole {
  OWNER // everything, including staff management
  MANAGER // everything except staff management
  SALES // orders, customers, catalog (read)
  WAREHOUSE // shipments and stock
  ACCOUNTS // finance, plus read access to what it bills
  CA_READONLY // external auditor: reads finance, changes nothing
  SUPPORT // grievances and order lookups
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               AdminRole @default(SUPPORT)
  isActive           Boolean   @default(true)
  /// Forces a password change on first login for seeded or reset accounts.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions  AdminSession[]
  auditLogs AdminAuditLog[]

  @@index([isActive])
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  /// Set when the session ends early: logout, password change, or an owner
  /// revoking it. A row is never deleted, so the audit trail holds.
  revokedAt   DateTime?
  ip          String?
  userAgent   String?
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId, revokedAt])
  @@index([expiresAt])
}

model AdminAuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  /// Kept alongside the relation so the trail survives a deleted staff row.
  actorEmail  String
  action      String // "expense.create", "product.update", "staff.create"
  entityType  String?
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([adminUserId, createdAt])
}

// ─── Stock register ───────────────────────────────────────────────────────────
// A point in time count, transcribed from the handwritten master register.
// Counts are in sets for graded material and in copies for single titles,
// because that is how the physical register is kept and an auditor reconciles
// against the physical register, not against our convenience.

enum StockUnit {
  SET
  COPY
}

model StockCount {
  id        String    @id @default(cuid())
  asOf      DateTime
  label     String
  sortOrder Int       @default(0)
  series    String?
  /// Set only for single titles that carry a register code of their own.
  sku       String?
  unit      StockUnit @default(SET)

  inward    Int
  outward   Int
  inventory Int

  /// Telugu and Hindi are tracked apart from the set, because a school can
  /// take the core set without a language book.
  inwardTelugu    Int?
  inwardHindi     Int?
  outwardTelugu   Int?
  outwardHindi    Int?
  inventoryTelugu Int?
  inventoryHindi  Int?

  /// The register's own "extra" and "from last year" columns, kept as written.
  carriedForward Int?
  extra          Int?
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([asOf, label])
  @@index([asOf])
}
