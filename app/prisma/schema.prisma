// SLPL Store data model.
// All money fields are integers in paise (₹1 = 100) — never floats.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Customers ────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  phone             String?
  passwordHash      String
  emailVerified     DateTime?
  image             String?
  lastLoginAt       DateTime?
  notificationPrefs Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  notifications Notification[]
  grievances    Grievance[]
  subscriptions Subscription[]
  entitlements  DigitalEntitlement[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum AddressLabel {
  HOME
  OFFICE
  OTHER
}

model Address {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     AddressLabel @default(HOME)
  name      String? // custom nickname, e.g. "Granny's house"
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  lat       Float?
  lng       Float?
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([userId])
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  sortOrder   Int       @default(0)
  products    Product[]
}

enum ProductKind {
  BOOK
  NOVEL
  POEMS
  BUNDLE
  /// Read online only. No file is ever handed over, so no stock and no parcel.
  DIGITAL
}

/// How a line is counted on an invoice.
enum ProductUnit {
  PCS
  SET
  BOOK
  YEAR
  SESSION
}

model Product {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  kind            ProductKind @default(BOOK)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  series          String?
  gradeLabel      String?
  description     String
  /// Master stock register code, e.g. BS1TEL01. See lib/sku.ts for the grammar.
  sku             String?     @unique
  /// 4901 for printed books, nil rated. SAC 9992 at 18% for services.
  hsnCode         String?
  /// Basis points, so 0% and 18% are exact: 0 and 1800.
  gstRate         Int         @default(0)
  unit            ProductUnit @default(PCS)
  /// What we paid. Restricted to OWNER and MANAGER on every screen.
  purchasePrice   Int?
  /// Selling below this needs approval.
  minPrice        Int?
  discountAllowed Boolean     @default(true)
  /// Withdrawn titles stay on old invoices but cannot be added to new ones.
  isActive        Boolean     @default(true)
  mrp             Int
  price           Int
  salePrice       Int?
  saleStart       DateTime?
  saleEnd         DateTime?
  stock           Int         @default(0)
  weightGrams     Int         @default(350)
  coverImage      String?
  gallery         String[]    @default([])
  samplePdf       String?
  /// DIGITAL only: how many pages the reader can turn.
  pageCount       Int?
  /// DIGITAL only: the folder under UPLOADS_DIR/editions holding the page images.
  editionKey      String?
  isNewRelease    Boolean     @default(false)
  isFeatured      Boolean     @default(false)
  isVisible       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  bundleItems  BundleItem[]         @relation("bundle")
  memberOf     BundleItem[]         @relation("member")
  cartItems    CartItem[]
  orderItems   OrderItem[]
  schoolKits   SchoolKit[]
  entitlements DigitalEntitlement[]

  @@index([categoryId, isVisible])
  @@index([isNewRelease, isVisible])
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Product @relation("bundle", fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation("member", fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([bundleId, productId])
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

enum OrderStatus {
  AWAITING_PAYMENT
  COD_PENDING_OTP
  PAID
  CONFIRMED // COD confirmed via OTP
  PAYMENT_FAILED
  EXPIRED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(AWAITING_PAYMENT)
  paymentMethod   PaymentMethod
  subtotal        Int
  discount        Int           @default(0)
  couponCode      String?
  shippingFee     Int           @default(0)
  total           Int
  // Snapshot of the delivery address at order time (source Address may change later)
  shippingAddress Json
  customerName    String
  customerEmail   String
  customerPhone   String
  notes           String?
  reservedUntil   DateTime?
  // COLLECT_AT_SCHOOL orders are handed over at the school, never couriered
  fulfilment      Fulfilment    @default(SHIP)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items         OrderItem[]
  payment       Payment?
  shipment      Shipment?
  events        OrderEvent[]
  grievances    Grievance[]
  kitPurchases  KitPurchase[]
  subscriptions Subscription[]
  entitlements  DigitalEntitlement[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  unitPrice Int
  quantity  Int
  image     String?
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String // "razorpay" | "cod"
  status            PaymentStatus @default(CREATED)
  amount            Int
  refundedAmount    Int           @default(0)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  method            String? // upi | card | netbanking | wallet
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  events PaymentEvent[]
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // Razorpay event id (or synthetic id for local transitions) — dedupes webhook retries
  eventId   String   @unique
  type      String
  payload   Json
  createdAt DateTime @default(now())
}

// ─── Shipping ─────────────────────────────────────────────────────────────────

enum ShipmentStatus {
  PENDING
  CREATED
  PICKUP_SCHEDULED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
}

model Shipment {
  id                   String         @id @default(cuid())
  orderId              String         @unique
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider             String // "shiprocket" | "manual"
  status               ShipmentStatus @default(PENDING)
  courierName          String?
  awb                  String?
  trackingUrl          String?
  labelUrl             String?
  shiprocketOrderId    String?
  shiprocketShipmentId String?
  etaDays              Int?
  trackingPhotoUrl     String? // courier receipt photo, served admin-only
  packedAt             DateTime?
  lastTrackedAt        DateTime? // last courier API poll, used to ration lookups
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  events ShipmentEvent[]

  @@index([status])
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  location    String?
  description String?
  occurredAt  DateTime @default(now())
  raw         Json?

  @@index([shipmentId])
}

model DeliveryEstimateCache {
  // key = `${pincode}:${weightBandGrams}`
  key       String   @id
  etaDays   Int
  charge    Int
  courier   String?
  expiresAt DateTime
}

// ─── Promotions ───────────────────────────────────────────────────────────────

enum DiscountType {
  PERCENT
  FLAT
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType
  value       Int // percent (1-100) or paise
  minOrder    Int          @default(0)
  maxDiscount Int?
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usedCount   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
}

model SaleEvent {
  id           String       @id @default(cuid())
  name         String
  bannerText   String
  discountType DiscountType
  value        Int
  categoryIds  String[]     @default([]) // empty = sitewide
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
}

// ─── Misc ─────────────────────────────────────────────────────────────────────

model OtpToken {
  id         String    @id @default(cuid())
  identifier String // email address
  code       String
  purpose    String // BULK_ORDER | COD_CONFIRM | EMAIL_VERIFY
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
}

model Setting {
  key   String @id
  value Json
}

model ServicePage {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  tagline     String?
  description String
  bannerImage String?
  externalUrl String?
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)
  /// Paise, so a workshop can be quoted without retyping its price
  price       Int?
  /// Basis points. Services are SAC 9992 at 18%, so 1800.
  gstRate     Int     @default(1800)
  hsnCode     String? @default("9992")
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String // SENT | FAILED
  error     String?
  createdAt DateTime @default(now())
}

// ─── Grievance redressal ──────────────────────────────────────────────────────
// Statutory complaint channel: the Consumer Protection (E-Commerce) Rules
// require a named officer, a 48 h acknowledgement and a 30 day resolution, so
// both clocks are stamped on the row at creation and reported on in admin.

enum GrievanceStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
  ESCALATED
}

enum GrievanceCategory {
  PAYMENT_DEBITED_NO_ORDER
  REFUND_NOT_RECEIVED
  DOUBLE_CHARGED
  ORDER_NOT_DELIVERED
  DAMAGED_OR_WRONG_ITEM
  CANCELLATION_ISSUE
  DATA_PRIVACY
  OTHER
}

enum GrievancePriority {
  NORMAL
  HIGH
  URGENT
}

model Grievance {
  id           String  @id @default(cuid())
  ticketNumber String  @unique // SLPL-G-YYMM-XXXXX
  accessToken  String  @unique // unguessable, powers the emailed tracking link
  userId       String? // null when filed by a guest
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId      String?
  order        Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // What the customer typed as their order number, kept even when unmatched
  orderRef     String?

  category    GrievanceCategory
  subject     String
  description String

  // Contact snapshot: guests have no account row to fall back on
  contactName  String
  contactEmail String
  contactPhone String?

  // Payment complaints: customer-supplied reference and the amount in dispute
  paymentRef    String?
  amountClaimed Int? // paise

  status   GrievanceStatus   @default(OPEN)
  priority GrievancePriority @default(NORMAL)

  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolution     String?
  ackDueAt       DateTime // createdAt + 48 h
  dueAt          DateTime // createdAt + 30 days

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events GrievanceEvent[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([contactEmail])
}

model GrievanceEvent {
  id                String    @id @default(cuid())
  grievanceId       String
  grievance         Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  status            String
  note              String?
  byAdmin           Boolean   @default(false)
  visibleToCustomer Boolean   @default(true)
  createdAt         DateTime  @default(now())

  @@index([grievanceId])
}

// ─── School kits ──────────────────────────────────────────────────────────────
// A parent pays online for one named student's kit, gets a receipt carrying a
// QR code, and the school hands the kit over against that receipt.

enum Fulfilment {
  SHIP
  COLLECT_AT_SCHOOL
}

enum KitPurchaseStatus {
  PENDING // order created, payment not through yet
  PAID
  READY // school has the kit set aside
  COLLECTED
  CANCELLED
}

model School {
  id           String  @id @default(cuid())
  code         String  @unique // short code used in URLs and on receipts
  name         String
  city         String
  state        String  @default("Telangana")
  // Matches Institution.udiseCode in the ERP so the two can be joined later
  udiseCode    String? @unique
  contactName  String?
  contactPhone String?
  contactEmail String?
  // Shared secret school staff type to reach the verification screen
  verifyPin    String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kits     SchoolKit[]
  students Student[]

  @@index([isActive])
}

model SchoolKit {
  id             String  @id @default(cuid())
  schoolId       String
  school         School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // The BUNDLE product carrying the price and the contents
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  academicYear   String // "2026-27"
  classLabel     String // "Grade 3"
  collectionNote String? // "Collect from the school office, 9am to 3pm"
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases KitPurchase[]

  @@unique([schoolId, academicYear, classLabel])
  @@index([schoolId, isActive])
}

model Student {
  id            String  @id @default(cuid())
  schoolId      String
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fullName      String
  classLabel    String
  section       String  @default("A")
  rollNumber    String
  guardianPhone String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases KitPurchase[]

  @@unique([schoolId, classLabel, section, rollNumber])
  @@index([schoolId, classLabel])
}

model KitPurchase {
  id            String            @id @default(cuid())
  receiptNumber String            @unique // SLPL-K-YYMM-XXXXX
  accessToken   String            @unique // the QR payload, unguessable
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  schoolKitId   String
  schoolKit     SchoolKit         @relation(fields: [schoolKitId], references: [id])
  studentId     String?
  student       Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  // Snapshots, so a roster edit or a transferred student cannot rewrite a receipt
  studentName   String
  classLabel    String
  section       String
  rollNumber    String?
  schoolName    String
  kitTitle      String
  amountPaid    Int // paise
  status        KitPurchaseStatus @default(PENDING)
  collectedAt   DateTime?
  collectedBy   String? // name the school staff member typed
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  events KitCollectionEvent[]

  @@index([schoolKitId, status])
  @@index([studentId])
  @@index([orderId])
}

model KitCollectionEvent {
  id            String      @id @default(cuid())
  purchaseId    String
  purchase      KitPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  status        String
  note          String?
  bySchoolStaff Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([purchaseId])
}

// ─── Director expense log ─────────────────────────────────────────────────────
// Every rupee that leaves the current account, logged as it is spent, so an
// audit can be answered with a printed statement instead of a shoebox.

enum ExpenseCategory {
  FUEL
  TRAVEL
  STATIONERY
  PRINTING
  PAPER
  COURIER
  OFFICE
  UTILITIES
  RENT
  REPAIRS
  PROFESSIONAL_FEES
  SALARIES
  MARKETING
  MEALS
  BANK_CHARGES
  MISC
}

enum PaidFrom {
  CURRENT_ACCOUNT
  CASH
  CARD
  UPI
  CHEQUE
}

model Expense {
  id          String          @id @default(cuid())
  voucherNo   String          @unique // SLPL-E-YYMM-XXXXX
  /// The date on the bill, not the date it was typed in
  spentAt     DateTime
  amount      Int // paise
  category    ExpenseCategory
  paidFrom    PaidFrom        @default(CURRENT_ACCOUNT)
  payee       String?
  note        String?
  /// Cheque number, UPI reference or the bank narration, for reconciliation
  reference   String?
  /// Photo of the bill, stored admin-only because bills carry addresses
  billImage   String?
  /// Filled only when the bill shows GST we could reclaim
  gstAmount   Int?
  vendorGstin String?
  enteredBy   String          @default("Director")
  /// Set when this was a payment to a vendor recorded from the Vendors screen
  vendorId    String?
  vendor      Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([spentAt])
  @@index([category, spentAt])
  @@index([vendorId, spentAt])
}

/// Someone we pay: a printer, a paper supplier, the landlord, the electricity
/// board. Each payment is an Expense, so the expense log stays the one record
/// of money out; a vendor with a due day is a recurring payment.
model Vendor {
  id            String          @id @default(cuid())
  name          String
  /// What its payments are filed under in the expense log
  category      ExpenseCategory @default(MISC)
  contactPerson String?
  phone         String?
  email         String?
  gstin         String?
  /// Bank account or UPI ID to pay them
  payTo         String?
  notes         String?
  /// A payment due every month, such as rent: the day it falls due (1 to 28)
  recurringDay  Int?
  /// The usual amount, paise. Left empty when it varies, as an electricity bill does
  recurringAmount Int?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  expenses      Expense[]

  @@index([isActive, name])
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// What a staff member paid for themselves, such as travel or food, sent to an
/// owner to approve. Kept apart from Expense, which is the company's own books.
model ExpenseClaim {
  id             String          @id @default(cuid())
  claimedById    String
  claimedBy      AdminUser       @relation(fields: [claimedById], references: [id], onDelete: Cascade)
  spentOn        DateTime
  amount         Int // paise
  category       ExpenseCategory
  /// Where and what for, such as "Bus to Uppal and back, Sunrise visit"
  note           String
  /// Photo of the bill, served to staff only
  billImage      String?
  status         ClaimStatus     @default(PENDING)
  decidedByName  String?
  decidedAt      DateTime?
  rejectedReason String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([claimedById, spentOn])
}

// ─── Staff accounts ───────────────────────────────────────────────────────────
// Ported verbatim from the ERP fork so the two systems stay schema compatible
// and the rest of its finance layer can follow without a rewrite.

enum AdminRole {
  OWNER // everything, including staff management
  MANAGER // everything except staff management
  SALES_MANAGER // runs the sales team, raises and approves quotations
  SALES // orders, customers, quotations (read)
  WAREHOUSE // shipments and stock
  ACCOUNTS // finance, plus read access to what it bills
  CA_READONLY // external auditor: reads finance, changes nothing
  SUPPORT // grievances and order lookups
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               AdminRole @default(SUPPORT)
  isActive           Boolean   @default(true)
  /// Forces a password change on first login for seeded or reset accounts.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  phone       String?
  /// Who they report to, so a sales team has a shape the screens can follow
  reportsToId String?
  reportsTo   AdminUser?  @relation("reports", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     AdminUser[] @relation("reports")
  expenseClaims ExpenseClaim[]
  passkeys      StaffPasskey[]

  sessions       AdminSession[]
  auditLogs      AdminAuditLog[]
  stockMovements StockMovement[]
  quotations     Quotation[]
  organizations  Organization[]
  visits         Visit[]
  invoices       Invoice[]
  targets        SalesTarget[]
  samplesIssued  SampleIssue[]
  giftsGiven     Gift[]

  @@index([isActive])
  @@index([reportsToId])
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  /// Set when the session ends early: logout, password change, or an owner
  /// revoking it. A row is never deleted, so the audit trail holds.
  revokedAt   DateTime?
  ip          String?
  userAgent   String?
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId, revokedAt])
  @@index([expiresAt])
}

/// Signing in with a fingerprint or face on one phone or computer (a WebAuthn
/// passkey). Signing a person out everywhere removes these too, so a lost
/// phone cannot get back in.
model StaffPasskey {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  /// The credential ID, base64url, as the browser reports it
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  /// Shown where they are listed, such as "Android phone, Chrome"
  deviceName   String
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([adminUserId])
}

model AdminAuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  /// Kept alongside the relation so the trail survives a deleted staff row.
  actorEmail  String
  action      String // "expense.create", "product.update", "staff.create"
  entityType  String?
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([adminUserId, createdAt])
}

// ─── Stock register ───────────────────────────────────────────────────────────
// A point in time count, transcribed from the handwritten master register.
// Counts are in sets for graded material and in copies for single titles,
// because that is how the physical register is kept and an auditor reconciles
// against the physical register, not against our convenience.

enum StockUnit {
  SET
  COPY
}

model StockCount {
  id        String    @id @default(cuid())
  asOf      DateTime
  label     String
  sortOrder Int       @default(0)
  series    String?
  /// Set only for single titles that carry a register code of their own.
  sku       String?
  unit      StockUnit @default(SET)

  inward    Int
  outward   Int
  inventory Int

  /// Telugu and Hindi are tracked apart from the set, because a school can
  /// take the core set without a language book.
  inwardTelugu    Int?
  inwardHindi     Int?
  outwardTelugu   Int?
  outwardHindi    Int?
  inventoryTelugu Int?
  inventoryHindi  Int?

  /// The register's own "extra" and "from last year" columns, kept as written.
  carriedForward Int?
  extra          Int?
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([asOf, label])
  @@index([asOf])
}

// ─── Magazine subscriptions ───────────────────────────────────────────────────
// Prepaid terms: the reader pays once for a fixed number of issues and we post
// each one as it prints. No mandate to manage, and it reuses the live Razorpay
// flow. Auto-renewal can be added later against the same record.

enum SubscriptionStatus {
  PENDING // order placed, payment not through
  ACTIVE
  COMPLETED // every issue in the term was sent
  CANCELLED
  REFUNDED
}

model Subscription {
  id        String   @id @default(cuid())
  /// SLPL-S-YYMM-XXXXX, printed on the welcome email and quoted by the reader
  code      String   @unique
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Set when a school bought it on an invoice rather than at /subscribe. It
  /// starts once that invoice is paid in full.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  /// Copies of each issue: a school buys one for every student
  copies    Int      @default(1)

  /// Snapshotted so a later profile edit cannot rewrite where issues were sent
  subscriberName String
  email          String
  phone          String
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  pincode        String

  termMonths      Int
  issuesTotal     Int
  issuesSent      Int                @default(0)
  amountPaid      Int // paise
  status          SubscriptionStatus @default(PENDING)
  startIssue      String // "September 2026", the first issue they receive
  startedAt       DateTime?
  endsAt          DateTime?
  /// Set when the pre-expiry reminder has gone out, so it is sent only once
  renewalNoticeAt DateTime?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispatches SubscriptionDispatch[]

  @@index([status, endsAt])
  @@index([email])
  @@index([invoiceId])
}

/// One row per issue posted, so a reader asking "did you send October" has an
/// answer, and the count of issues sent is never a guess.
model SubscriptionDispatch {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  issueLabel     String
  sentAt         DateTime     @default(now())
  note           String?

  @@unique([subscriptionId, issueLabel])
  @@index([subscriptionId])
}

// ─── Digital editions ─────────────────────────────────────────────────────────
// Read in the browser, never downloaded. A browser cannot stop a screenshot, so
// the deterrent is that every page carries the buyer's name: a leaked page is a
// signed page. The entitlement is the licence; the order stays at PAID, exactly
// as kits and subscriptions do.

model DigitalEntitlement {
  id           String    @id @default(cuid())
  /// SLPL-D-YYMM-XXXXX, printed in the watermark so a leak names its source
  code         String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  grantedAt    DateTime  @default(now())
  /// Set by hand from the back office when the view log shows a shared login
  revokedAt    DateTime?
  revokeReason String?
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  views DigitalViewLog[]

  /// One licence per reader per issue: paying twice cannot make two
  @@unique([userId, productId])
  @@index([productId, revokedAt])
}

/// Enough to spot one login being passed around a classroom.
model DigitalViewLog {
  id            String             @id @default(cuid())
  entitlementId String
  entitlement   DigitalEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  page          Int
  ip            String?
  userAgent     String?
  at            DateTime           @default(now())

  @@index([entitlementId, at])
}

// ─── Stock movements ──────────────────────────────────────────────────────────
// The StockCount rows are a snapshot: the register as it stood on one day. This
// is everything that has happened since, so any month's statement is opening
// plus movements equals closing, and the closing rolls into the next month.
// Nothing here is ever deleted: a mistake is reversed by its own line, because
// a statement that goes to a bank cannot have silent edits in its history.

enum StockMoveKind {
  INWARD // received from the printer
  OUTWARD // issued to a school or a customer
  RETURN_IN // came back from a school
  RETURN_OUT // sent back to the printer
  ADJUSTMENT // correction after a physical count
}

model StockMovement {
  id  String @id @default(cuid())
  /// SLPL-M-YYMM-XXXXX, so a line can be quoted in a letter to the bank
  ref String @unique

  movedAt DateTime
  kind    StockMoveKind
  /// The register line this moves, e.g. "Grade 1 Term 2". Matches StockCount.label.
  label   String
  series  String?
  unit    StockUnit     @default(SET)

  /// Signed: positive adds to the balance, negative takes away. The form asks
  /// for a positive number and the kind decides the sign.
  quantity       Int
  /// Telugu and Hindi move apart from the set, as the register keeps them
  quantityTelugu Int?
  quantityHindi  Int?

  /// The school, printer or customer on the other side
  party    String?
  /// Delivery challan, invoice or credit note number
  document String?
  note     String?

  recordedById  String?
  recordedBy    AdminUser? @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  /// Kept alongside the relation so the trail survives a staff row being removed
  recordedEmail String

  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())

  @@index([movedAt])
  @@index([label, movedAt])
}

// ─── Quotations ───────────────────────────────────────────────────────────────
// What sales sends a school before an order exists. Everything about the buyer
// is snapshotted, because a quotation already in someone's inbox must not
// change when the customer record is later edited.

enum QuotationStatus {
  DRAFT
  /// Raised by an executive, waiting for the sales manager
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id     String          @id @default(cuid())
  /// SLPL/Q/26-27/0001, continuous within a financial year
  number String          @unique
  status QuotationStatus @default(DRAFT)

  quotedOn   DateTime @default(now())
  validUntil DateTime

  customerName  String
  contactPerson String?
  phone         String?
  email         String?
  addressLine   String?
  city          String?
  state         String?
  pincode       String?
  gstin         String?
  /// Decides CGST plus SGST against IGST. Our own state is Telangana.
  placeOfSupply String  @default("Telangana")

  /// Where the goods go, when that is not the billing address. Blank means
  /// the same as BILL TO.
  shipToName    String?
  shipToAddress String?

  /// All money in paise, like everything else
  subtotal Int @default(0)
  discount Int @default(0)
  taxable  Int @default(0)
  cgst     Int @default(0)
  sgst     Int @default(0)
  igst     Int @default(0)
  total    Int @default(0)

  terms String?
  notes String?

  createdById  String?
  createdBy    AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Kept alongside the relation so the trail survives a staff row going away
  createdEmail String

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// A quotation raised by an executive waits for the sales manager
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?

  /// Flat percentage off the whole bill, in basis points, as the samples do
  billDiscountBp Int @default(0)

  sentAt    DateTime?
  decidedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items QuotationItem[]

  @@index([status, quotedOn])
  @@index([customerName])
}

model QuotationItem {
  id             String    @id @default(cuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  /// Snapshotted, so a later price change cannot rewrite a quotation
  productId      String?
  description    String
  /// Copied from the price list line when picked, so a later edit there leaves this quotation alone
  contents       String?
  /// 4901 for books, 9992 for services
  hsnCode        String?
  unit           String    @default("Nos")
  quantity       Int       @default(1)
  /// Printed price before discount. The rate is MRP less the discount.
  mrp            Int?
  unitPrice      Int
  /// Percent in basis points, so 12.5% is 1250
  discountBp     Int       @default(0)
  /// A discount given as money for the whole line, in paise. Used instead of
  /// the percentage when set, because Rs 15,000 off Rs 1,75,000 is 8.5714%
  /// and no whole number of basis points lands on it exactly.
  discountAmount Int       @default(0)
  /// Basis points: nil for books, 500 for an e-book, 1800 for a service
  gstRate        Int       @default(0)
  lineTotal      Int       @default(0)
  sortOrder      Int       @default(0)

  @@index([quotationId])
}

/// What sales quote, kept apart from store prices on purpose: the owner was
/// explicit that changing one must never move the other. Many entries are not
/// store products at all, such as a UPSC full set for a grade.
model PriceListItem {
  id          String  @id @default(cuid())
  /// Groups the picker and the price list screen, e.g. "Little Leaps Grade 3"
  group       String
  description String
  /// What a set holds, such as its books, printed under the line on a quotation
  contents    String?
  hsnCode     String? @default("4901")
  unit        String  @default("PCS")
  /// Printed price, paise. Shown as MRP on an invoice.
  mrp         Int?
  /// What we quote, paise
  rate        Int
  /// Basis points: nil for books, 1800 for a service
  gstRate     Int     @default(0)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  updatedEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([group, sortOrder])
}

// ─── Document numbering ───────────────────────────────────────────────────────

/// One row per series. Allocation takes SELECT ... FOR UPDATE inside the
/// caller's transaction, so a duplicate or a skipped statutory number is
/// structurally impossible however many people press save at once.
model NumberSeries {
  key       String   @id
  next      Int      @default(1)
  updatedAt DateTime @updatedAt
}

// ─── Sales and CRM ────────────────────────────────────────────────────────────
// One organisation, one record. The owner was explicit that a new enquiry must
// never create a second, so everything hangs off this: visits, quotations,
// invoices, payments, samples and gifts.

enum OrganizationKind {
  SCHOOL
  COLLEGE
  DISTRIBUTOR
  INSTITUTION
  INDIVIDUAL
}

enum OrganizationStatus {
  LEAD
  ACTIVE
  DORMANT
  LOST
}

model Organization {
  id   String           @id @default(cuid())
  /// Three letters from the name, used in the invoice number. Cambridge -> CAM
  code String           @unique
  name String
  kind OrganizationKind @default(SCHOOL)

  contactPerson String?
  designation   String?
  phone         String?
  email         String?
  addressLine   String?
  city          String?
  state         String? @default("Telangana")
  pincode       String?
  gstin         String?

  /// Whoever is responsible for this school
  ownerId String?
  owner   AdminUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  source String?
  status OrganizationStatus @default(LEAD)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits     Visit[]
  quotations Quotation[]
  invoices   Invoice[]
  receipts   Receipt[]
  samples    SampleIssue[]
  gifts      Gift[]
  challans   DeliveryChallan[]

  @@index([status])
  @@index([ownerId])
  @@index([name])
}

enum VisitKind {
  VISIT
  CALL
  MEETING
  DEMO
  SAMPLE_DROP
  FOLLOW_UP
  PAYMENT_CHASE
  NOTE
}

/// What a salesperson did, and what they will do next. The next action is not
/// optional: the owner's rule is that nothing sits in the system saying only
/// "Called".
model Visit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  byId    String?
  by      AdminUser? @relation(fields: [byId], references: [id], onDelete: SetNull)
  /// Kept so the trail survives a staff row going away
  byEmail String

  visitedOn DateTime
  kind      VisitKind @default(VISIT)
  metWith   String?
  summary   String
  outcome   String?

  nextAction   String
  nextActionOn DateTime

  /// Set when this visit turned into money, with the invoice that proves it
  converted Boolean  @default(false)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, visitedOn])
  @@index([byId, visitedOn])
  @@index([nextActionOn])
}

enum TargetScope {
  COMPANY
  PERSON
}

enum TargetPeriod {
  MONTH
  YEAR
}

model SalesTarget {
  id     String       @id @default(cuid())
  scope  TargetScope
  period TargetPeriod

  /// First day of the month or of the financial year this target covers
  periodStart DateTime

  ownerId String?
  owner   AdminUser? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Paise, as a BigInt: the company's Rs 5 crore year is 5,000,000,000 paise,
  /// more than a plain Int can hold
  revenueTarget      BigInt @default(0)
  visitTarget        Int @default(0)
  organizationTarget Int @default(0)

  setByEmail String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scope, ownerId, period, periodStart])
  @@index([periodStart])
}

// ─── Invoices ─────────────────────────────────────────────────────────────────
// A bill of supply when every line is nil rated, a tax invoice the moment any
// line carries GST. The system decides, because that is the kind of choice that
// gets made wrong under time pressure and shows up in an audit.

enum InvoiceKind {
  BILL_OF_SUPPLY
  TAX_INVOICE
}

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PAID
  CANCELLED
}

enum ProductLine {
  MAG
  BOOK
  SVC
}

model Invoice {
  id          String        @id @default(cuid())
  /// MAG/SLPL/09-26/CAM01
  number      String        @unique
  kind        InvoiceKind   @default(BILL_OF_SUPPLY)
  productLine ProductLine   @default(BOOK)
  status      InvoiceStatus @default(DRAFT)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// Snapshotted, so editing a school later cannot rewrite a bill already sent
  customerName  String
  contactPerson String?
  phone         String?
  email         String?
  addressLine   String?
  city          String?
  state         String?
  pincode       String?
  gstin         String?
  placeOfSupply String  @default("Telangana")

  invoiceDate DateTime @default(now())
  dueDate     DateTime

  subtotal       Int @default(0)
  /// Flat percentage off the whole bill, in basis points, as the sample does
  billDiscountBp Int @default(0)
  discount       Int @default(0)
  taxable        Int @default(0)
  cgst           Int @default(0)
  sgst           Int @default(0)
  igst           Int @default(0)
  total          Int @default(0)

  terms String?
  notes String?

  quotationId String?

  createdById  String?
  createdBy    AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdEmail String

  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?

  sentAt      DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items         InvoiceItem[]
  allocations   ReceiptAllocation[]
  visits        Visit[]
  challans      DeliveryChallan[]
  subscriptions Subscription[]

  @@index([status, invoiceDate])
  @@index([organizationId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId   String?
  description String
  hsnCode     String?
  unit        String  @default("Nos")
  quantity    Int     @default(1)
  /// Printed price before discount. The rate is MRP less the discount.
  mrp         Int?
  unitPrice   Int
  discountBp  Int     @default(0)
  gstRate     Int     @default(0)
  /// A charge outside the bill discount, such as delivery: the discount on the
  /// books must not quietly discount the courier too
  noBillDiscount Boolean @default(false)
  lineTotal   Int     @default(0)
  sortOrder   Int     @default(0)

  @@index([invoiceId])
}

// ─── Money in ─────────────────────────────────────────────────────────────────

enum PaymentMode {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  CARD
  RAZORPAY
  OTHER
}

/// What a school actually paid. Previous and current balance on an invoice are
/// computed from these, never typed, so they cannot drift from reality.
model Receipt {
  id     String @id @default(cuid())
  /// SLPL/R/26-27/0001
  number String @unique

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  receivedOn DateTime
  amount     Int
  mode       PaymentMode @default(BANK_TRANSFER)
  reference  String?
  notes      String?

  recordedEmail String
  createdAt     DateTime @default(now())

  /// Voided, never deleted, so a receipt number is never missing
  voidedAt   DateTime?
  voidReason String?

  allocations ReceiptAllocation[]

  @@index([organizationId, receivedOn])
}

model ReceiptAllocation {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Int

  @@unique([receiptId, invoiceId])
  @@index([invoiceId])
}

// ─── Dispatch ─────────────────────────────────────────────────────────────────

/// What travels with the goods. Deliberately NOT an e-way bill: that is issued
/// by the NIC portal and nothing we print is one, which the document says in
/// its own footer so nobody in the warehouse mistakes it.
model DeliveryChallan {
  id     String @id @default(cuid())
  /// SLPL/DC/26-27/0001
  number String @unique

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  dispatchedOn DateTime

  fromAddress String
  toName      String
  toAddress   String

  /// Blank at raise time, because the vehicle is not known until it arrives
  transporter   String?
  vehicleNumber String?

  notes String?

  recordedEmail String
  createdAt     DateTime @default(now())

  items ChallanItem[]

  @@index([dispatchedOn])
}

model ChallanItem {
  id          String          @id @default(cuid())
  challanId   String
  challan     DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  description String
  unit        String          @default("Nos")
  quantity    Int             @default(1)
  sortOrder   Int             @default(0)

  @@index([challanId])
}

// ─── Samples and gifts ────────────────────────────────────────────────────────

enum SampleStatus {
  /// Taken from the office, still in the salesperson's bag
  IN_HAND
  WITH_SCHOOL
  RETURNED
  CONVERTED
  WRITTEN_OFF
}

/// An executive's batch waits for the sales manager before it goes to a school
enum SampleApproval {
  PENDING
  APPROVED
  REJECTED
}

/// Specimen copies a salesperson carries. They are stock in someone's hands
/// first and only sometimes end up at a school, so the school is optional and
/// is named when the copies are actually handed over.
model SampleIssue {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  productId   String?
  description String
  quantity    Int     @default(1)

  /// Who has them: the salesperson who took them from the office
  issuedById  String?
  issuedBy    AdminUser? @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  issuedEmail String
  /// When they left the office
  issuedOn    DateTime

  status     SampleStatus @default(IN_HAND)
  /// When they were handed to the school
  givenOn    DateTime?
  returnedOn DateTime?
  notes      String?

  /// Approved by default so rows from before the approval step stay valid
  approvalStatus SampleApproval @default(APPROVED)
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([issuedById, status])
  @@index([approvalStatus])
  @@index([status])
}

model Gift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  description String
  /// Paise, so the spend can be totalled against a school
  value       Int?
  givenToName String?

  givenById  String?
  givenBy    AdminUser? @relation(fields: [givenById], references: [id], onDelete: SetNull)
  givenEmail String
  givenOn    DateTime

  notes     String?
  createdAt DateTime @default(now())

  @@index([organizationId])
}
